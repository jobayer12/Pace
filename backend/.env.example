# Application
NODE_ENV=development
PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=load_testing

# Knex pool
DB_POOL_MIN=2
DB_POOL_MAX=10

# Logging
LOG_LEVEL=debug
SERVICE_NAME=backend

# API docs
SWAGGER_ENABLED=true

# CORS — comma-separated origins allowed to call the API from a browser.
# Leave empty when the caller is same-origin (e.g. Swagger UI behind the tunnel).
# Example: CORS_ORIGINS=https://loadtest.jobayer.me,http://localhost:5173
CORS_ORIGINS=
