# Application
NODE_ENV=development
PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=load_testing

# Knex pool
DB_POOL_MIN=2
DB_POOL_MAX=10

# Query limits (ms). A query running longer than DB_STATEMENT_TIMEOUT_MS is
# cancelled by Postgres; waiting longer than DB_ACQUIRE_TIMEOUT_MS for a pool
# connection also fails. Both return 500, which k6 counts as a failed request.
DB_STATEMENT_TIMEOUT_MS=3000
DB_ACQUIRE_TIMEOUT_MS=3000

# Logging
LOG_LEVEL=debug
SERVICE_NAME=backend

# API docs
SWAGGER_ENABLED=true

# CORS — comma-separated origins allowed to call the API from a browser.
# Leave empty when the caller is same-origin (e.g. Swagger UI behind the tunnel).
# Example: CORS_ORIGINS=https://loadtest.jobayer.me,http://localhost:5173
CORS_ORIGINS=

# Cluster — number of worker processes. Empty/0 = one per CPU, 1 = no cluster.
# Each worker opens its own DB pool (up to DB_POOL_MAX connections).
CLUSTER_WORKERS=

# OpenTelemetry — traces + metrics pushed over OTLP to the local Grafana Alloy,
# which forwards them to Tempo / Prometheus. Set OTEL_SDK_DISABLED=true to turn
# it off (e.g. locally without Alloy).
OTEL_SDK_DISABLED=false
OTEL_SERVICE_NAME=backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Keep 10% of traces under load; metrics still count every request.
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1
# How often each worker pushes metrics (ms).
OTEL_METRIC_EXPORT_INTERVAL=15000
