{
  "title": "Backend — API response time",
  "uid": "backend-otel",
  "tags": ["backend", "opentelemetry"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "prom",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      },
      {
        "name": "tempo",
        "label": "Tempo",
        "type": "datasource",
        "query": "tempo",
        "current": {}
      },
      {
        "name": "route",
        "label": "Route",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${prom}" },
        "query": {
          "query": "label_values(http_server_request_duration_seconds_count{job=\"backend\"}, http_route)",
          "refId": "route"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "slow",
        "label": "Slow trace threshold",
        "type": "custom",
        "query": "50ms,100ms,250ms,500ms,1s,2s",
        "current": { "text": "250ms", "value": "250ms" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Requests / sec",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${prom}" },
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 1 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_request_duration_seconds_count{job=\"backend\", http_route=~\"$route\"}[$__rate_interval]))"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "p95 response time",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${prom}" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.25 },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"backend\", http_route=~\"$route\"}[$__rate_interval])))"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "5xx error rate",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${prom}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(http_server_request_duration_seconds_count{job=\"backend\", http_route=~\"$route\", http_response_status_code=~\"5..\"}[$__rate_interval])) or vector(0)) / sum(rate(http_server_request_duration_seconds_count{job=\"backend\", http_route=~\"$route\"}[$__rate_interval]))"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Workers reporting",
      "description": "Cluster workers that pushed metrics in the last 2 minutes (one per service.instance.id).",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${prom}" },
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" },
      "targets": [
        {
          "refId": "A",
          "expr": "count(count by (instance) (last_over_time(target_info{job=\"backend\"}[2m])))"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Response time percentiles",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${prom}" },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "p50",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"backend\", http_route=~\"$route\"}[$__rate_interval])))"
        },
        {
          "refId": "B",
          "legendFormat": "p95",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"backend\", http_route=~\"$route\"}[$__rate_interval])))"
        },
        {
          "refId": "C",
          "legendFormat": "p99",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"backend\", http_route=~\"$route\"}[$__rate_interval])))"
        },
        {
          "refId": "D",
          "legendFormat": "avg",
          "expr": "sum(rate(http_server_request_duration_seconds_sum{job=\"backend\", http_route=~\"$route\"}[$__rate_interval])) / sum(rate(http_server_request_duration_seconds_count{job=\"backend\", http_route=~\"$route\"}[$__rate_interval]))"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "p95 response time by route",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${prom}" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{http_request_method}} {{http_route}}",
          "expr": "histogram_quantile(0.95, sum by (le, http_request_method, http_route) (rate(http_server_request_duration_seconds_bucket{job=\"backend\", http_route=~\"$route\"}[$__rate_interval])))"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Requests / sec by status code",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${prom}" },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "stacking": { "mode": "normal" }, "fillOpacity": 30 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{http_response_status_code}}",
          "expr": "sum by (http_response_status_code) (rate(http_server_request_duration_seconds_count{job=\"backend\", http_route=~\"$route\"}[$__rate_interval]))"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Requests / sec by route",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${prom}" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{http_request_method}} {{http_route}}",
          "expr": "sum by (http_request_method, http_route) (rate(http_server_request_duration_seconds_count{job=\"backend\", http_route=~\"$route\"}[$__rate_interval]))"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Postgres query p95 by operation",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${prom}" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{db_operation_name}}",
          "expr": "histogram_quantile(0.95, sum by (le, db_operation_name) (rate(db_client_operation_duration_seconds_bucket{job=\"backend\"}[$__rate_interval])))"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Event loop delay p99 per worker",
      "description": "High values mean a worker's CPU is saturated and requests are waiting to be picked up.",
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${prom}" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{instance}}",
          "expr": "max by (instance) ({__name__=~\"nodejs_eventloop_delay_p99(_seconds)?\", job=\"backend\"})"
        }
      ]
    },
    {
      "id": 11,
      "type": "table",
      "title": "Slow requests (traces over $slow) — click a Trace ID to open it",
      "gridPos": { "x": 0, "y": 28, "w": 24, "h": 10 },
      "datasource": { "type": "tempo", "uid": "${tempo}" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "tempo", "uid": "${tempo}" },
          "queryType": "traceql",
          "query": "{ resource.service.name = \"backend\" && kind = server && duration > $slow }",
          "limit": 50,
          "tableType": "traces"
        }
      ]
    }
  ]
}
